# Local / staging app overlay env — COPY to deploy/app.env (gitignored).
# Never commit real secrets. Placeholders below are for docker-compose smoke only.
# Full host/registry/rollback steps: deploy/STAGING-RUNBOOK.md

# ---------------------------------------------------------------- runtime
# Use ENV=dev for local docker against compose infra (sandbox OTP OK).
# Real staging host: ENV=staging requires non-sandbox OTP + strong secrets +
# a non-localhost PUBLIC_BASE_URL (see backend/.env.example + config.validate).
ENV=dev
API_HOST_PORT=8080
WEB_HOST_PORT=3000

# After registry push, pin images (leave unset for local :local tags / build):
# API_IMAGE=ghcr.io/YOUR_ORG/avtotest-api:GIT_SHA
# WEB_IMAGE=ghcr.io/YOUR_ORG/avtotest-web:GIT_SHA

# ------------------------------------------------------------- datastores
# Hostnames `postgres` / `redis` resolve on the compose network from `make up`.
DATABASE_URL=postgres://avtotest:avtotest@postgres:5432/avtotest?sslmode=disable
REDIS_URL=redis://redis:6379/0
MEDIA_BASE_URL=http://localhost:9000/media

# Origin users browse — the FRONTEND, not the API. Referral invite_url and
# payment return URLs are built from this.
PUBLIC_BASE_URL=http://localhost:3000

# Next.js BFF → Go API (compose service name).
BACKEND_URL=http://api:8080

# ------------------------------------------------------------------- auth
JWT_SECRET=dev-secret-change-me-local-docker-32b
OTP_CHANNEL=sandbox
# 32+ bytes; required by the production Next image (NODE_ENV=production).
# Must be identical on api + web.
CLIENT_IP_ASSERTION_SECRET=local-docker-client-ip-assertion-secret-32b
# Overlay has no reverse proxy; auth IP assertion needs X-Forwarded-For from
# a trusted proxy in real staging. Keep 1 for the documented shape.
TRUSTED_PROXY_HOPS=1

# ---------------------------------------------------------- observability (U-41)
# Optional. Empty = Sentry SDKs stay no-op on api + web. No pager invented here.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Humocardbot watcher ingest token (api + humo-watcher must match)
MANUAL_PAY_INGEST_TOKEN=local-manual-pay-ingest-token-change-me
