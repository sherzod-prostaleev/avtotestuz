BACKEND_URL=http://localhost:8090
# Docker / staging overlay uses the compose service name instead, e.g.
# BACKEND_URL=http://api:8080 — see deploy/README.md (PUBLIC_BASE_URL is an
# API-side env: the frontend origin users browse).
# Local `next dev` may leave both values empty and safely fall back to the
# backend connection IP. Production requires a 32+ byte shared secret and the
# exact number of trusted proxies that append X-Forwarded-For before Next.js.
CLIENT_IP_ASSERTION_SECRET=
TRUSTED_PROXY_HOPS=
