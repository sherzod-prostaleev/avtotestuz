# Copy to ~/.config/drivergo/offhost-pull.env and chmod 600.
# Used only on the operator PC by pull_offhost.sh / the user systemd unit.
# Quote any path that contains spaces (e.g. ~/Рабочий стол/...).

# Absolute path to pull_offhost.sh in this checkout (required by the user unit)
OFFHOST_PULL_SCRIPT="/home/REPLACE_ME/Рабочий стол/avtotest/scripts/backup/pull_offhost.sh"

# Same shape as deploy/sync-to-vps.sh DEPLOY_HOST
OFFHOST_SSH_HOST=root@89.117.59.137

# Absolute path on the VPS
REMOTE_BACKUP_ROOT=/var/backups/drivergo/full

# Absolute path on this PC (mode 0700, owned by you)
LOCAL_OFFHOST_ROOT="/home/REPLACE_ME/drivergo-offhost/full"

OFFHOST_LOCK_FILE="/home/REPLACE_ME/drivergo-offhost/pull.lock"
OFFHOST_RETENTION_DAYS=35
OFFHOST_MIN_SNAPSHOTS=3
SSH_CONNECT_TIMEOUT=15
