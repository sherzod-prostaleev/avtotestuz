# Production host env for deploy/docker-compose.prod.yml
# Copy to deploy/app.env on the VPS (chmod 600). Never commit real secrets.
#
# Ports chosen to avoid other projects on the same host:
#   web 127.0.0.1:3010  |  api 127.0.0.1:8081  |  minio 127.0.0.1:9010
#   (system postgres:5432 / redis:6379 / movix:8080 / avtomoto:3005 untouched)

# prod turns on the startup fail-safes in internal/config.validate:
# sandbox OTP is refused, JWT_SECRET must be >=32 bytes and not the dev
# default, CLIENT_IP_ASSERTION_SECRET must be set, PUBLIC_BASE_URL must be
# a real origin. Leaving this at "dev" on a live host silently disables all
# of them — that is how the OTP echo reached production once already.
ENV=prod
API_HOST_PORT=8081
WEB_HOST_PORT=3010

POSTGRES_PASSWORD=CHANGE_ME_PG
MINIO_ROOT_USER=drivergo
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO

DATABASE_URL=postgres://avtotest:CHANGE_ME_PG@postgres:5432/avtotest?sslmode=disable
REDIS_URL=redis://redis:6379/0
DB_POOL_MAX_CONNS=20
DB_POOL_MIN_CONNS=2
DB_POOL_MAX_LIFETIME=30m
DB_POOL_MAX_IDLE_TIME=5m
DB_POOL_HEALTH_CHECK_PERIOD=1m
MEDIA_BASE_URL=https://drivergo.uz/media
PUBLIC_BASE_URL=https://drivergo.uz
CORS_ALLOWED_ORIGINS=https://drivergo.uz
BACKEND_URL=http://api:8080

# Signs learner + admin JWTs. Rotating it signs everyone out and, as long as
# DATA_ENCRYPTION_KEY below is set, costs nothing else.
JWT_SECRET=CHANGE_ME_JWT_32_BYTES_MINIMUM_LENGTH_HERE

# !!! ROTATING THIS KEY IS IRREVERSIBLE DATA LOSS !!!
# It derives the AES-GCM key for every value encrypted at rest:
#   admin_user.totp_secret_enc (all admin authenticators),
#   manual_pay_card.pan_full and referral_payout.card_number (card numbers),
#   manual_tg_settings.*_enc (Telethon api_id/api_hash/session).
# Change it and all of them become permanently undecryptable — no migration,
# no re-encryption, no recovery. Admins would have to re-enroll TOTP and the
# Telegram session would have to be recreated.
#
# ON AN ALREADY-RUNNING HOST: set this to the EXACT value JWT_SECRET has right
# now (empty means "fall back to JWT_SECRET", which is how the existing rows
# were encrypted). Doing that changes nothing on disk and makes every later
# JWT_SECRET rotation safe. On a brand-new host, generate an independent
# random value. >=32 bytes. cmd/encryptpan must be run with the same value.
DATA_ENCRYPTION_KEY=CHANGE_ME_SET_TO_CURRENT_JWT_SECRET_ON_EXISTING_HOSTS

CLIENT_IP_ASSERTION_SECRET=CHANGE_ME_CLIENT_IP_ASSERTION_32_BYTES_MIN
# Existing users sign in with phone+password. New registration requires a
# delivered OTP; use "telegram" with a real Gateway token. "off" deliberately
# disables new registration and is only a temporary maintenance mode.
#   sandbox = logs the code, never delivers it — rejected when ENV=prod.
#   telegram = OTP Gateway API, needs TELEGRAM_GATEWAY_TOKEN (a different
#              product from TELEGRAM_BOT_TOKEN below).
OTP_CHANNEL=telegram
TELEGRAM_GATEWAY_TOKEN=CHANGE_ME_TELEGRAM_GATEWAY_TOKEN
# Only meaningful with OTP_CHANNEL=sandbox, and refused outright when
# ENV=prod: it returns the OTP in the HTTP response, which is account
# takeover for any phone number.
OTP_DEBUG_ECHO=false
TRUSTED_PROXY_HOPS=2

# Applies to EVERY admin role. An admin without an enrolled authenticator is
# refused a session (403 totp_setup_required) but is handed a short-lived
# enrollment_token that opens only /admin/v1/security/totp/{enroll,confirm},
# so switching this on — or creating an admin afterwards — no longer locks
# anyone out. Still worth enrolling active admins before flipping it.
ADMIN_TOTP_ENFORCE=true

PAYME_ENV=prod

# Humocardbot watcher ↔ API (generate a long random string; same value for api + humo-watcher)
MANUAL_PAY_INGEST_TOKEN=CHANGE_ME_MANUAL_PAY_INGEST_TOKEN

# Optional later (ENV=staging|prod requires non-sandbox OTP):
# TELEGRAM_GATEWAY_TOKEN=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_BOT_MODE=off
# Sticker sent to a group when a /quiz game ends. Leave unset to send none —
# an unverified file_id would fail on every finished game.
# TELEGRAM_QUIZ_WINNER_STICKER=
