[Unit]
Description=Publish Driver Go host operations metrics
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/drivergo
Environment="TEXTFILE_DIR=/var/lib/drivergo-monitoring/textfile"
Environment="MONITORING_LOCK_FILE=/run/drivergo-monitoring/collector.lock"
Environment="DOCKER_CONFIG=/run/drivergo-monitoring/docker-config"
Environment="COMPOSE_FILE=/opt/drivergo/deploy/docker-compose.prod.yml"
Environment="COMPOSE_ENV_FILE=/opt/drivergo/deploy/app.env"
Environment="BACKUP_ROOT=/var/backups/drivergo/full"
Environment="BACKUP_VERIFY_SCRIPT=/opt/drivergo/scripts/backup/verify_snapshot.sh"
Environment="BACKUP_VERIFY_CACHE_DIR=/var/lib/drivergo-monitoring/backup-verify-cache"
Environment="BACKUP_VERIFY_CACHE_TTL_SECONDS=90000"
EnvironmentFile=-/etc/drivergo/monitoring.env
ExecStart=/usr/local/libexec/drivergo-monitoring-collector
StateDirectory=drivergo-monitoring
StateDirectoryMode=0755
RuntimeDirectory=drivergo-monitoring
RuntimeDirectoryMode=0700
UMask=0022
TimeoutStartSec=30m
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateDevices=true
PrivateNetwork=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/drivergo-monitoring /run/drivergo-monitoring
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
