# Production host env for deploy/docker-compose.prod.yml
# Copy to deploy/app.env on the VPS (chmod 600). Never commit real secrets.
#
# Ports chosen to avoid other projects on the same host:
#   web 127.0.0.1:3010  |  api 127.0.0.1:8081  |  minio 127.0.0.1:9010
#   (system postgres:5432 / redis:6379 / movix:8080 / avtomoto:3005 untouched)

# prod turns on the startup fail-safes in internal/config.validate:
# sandbox OTP is refused, JWT_SECRET must be >=32 bytes and not the dev
# default, CLIENT_IP_ASSERTION_SECRET must be set, PUBLIC_BASE_URL must be
# a real origin. Leaving this at "dev" on a live host silently disables all
# of them — that is how the OTP echo reached production once already.
ENV=prod
API_HOST_PORT=8081
WEB_HOST_PORT=3010

POSTGRES_PASSWORD=CHANGE_ME_PG
MINIO_ROOT_USER=drivergo
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO

DATABASE_URL=postgres://avtotest:CHANGE_ME_PG@postgres:5432/avtotest?sslmode=disable
REDIS_URL=redis://redis:6379/0
MEDIA_BASE_URL=https://drivergo.uz/media
PUBLIC_BASE_URL=https://drivergo.uz
BACKEND_URL=http://api:8080

JWT_SECRET=CHANGE_ME_JWT_32_BYTES_MINIMUM_LENGTH_HERE
CLIENT_IP_ASSERTION_SECRET=CHANGE_ME_CLIENT_IP_ASSERTION_32_BYTES_MIN
# Sign-in is phone+password; OTP is not wired into the UI. "off" keeps the
# endpoints mounted but inert (404, no code ever generated) and needs no
# SMS/Telegram gateway, so ENV=prod is reachable without one.
#   sandbox = logs the code, never delivers it — rejected when ENV=prod.
#   telegram = OTP Gateway API, needs TELEGRAM_GATEWAY_TOKEN (a different
#              product from TELEGRAM_BOT_TOKEN below).
OTP_CHANNEL=off
# Only meaningful with OTP_CHANNEL=sandbox, and refused outright when
# ENV=prod: it returns the OTP in the HTTP response, which is account
# takeover for any phone number.
OTP_DEBUG_ECHO=false
TRUSTED_PROXY_HOPS=2

ADMIN_TOTP_ENFORCE=false

# Humocardbot watcher ↔ API (generate a long random string; same value for api + humo-watcher)
MANUAL_PAY_INGEST_TOKEN=CHANGE_ME_MANUAL_PAY_INGEST_TOKEN

# Optional later (ENV=staging|prod requires non-sandbox OTP):
# TELEGRAM_GATEWAY_TOKEN=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_BOT_MODE=off
# Sticker sent to a group when a /quiz game ends. Leave unset to send none —
# an unverified file_id would fail on every finished game.
# TELEGRAM_QUIZ_WINNER_STICKER=
