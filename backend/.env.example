# AvtoTest backend configuration.
#
# Every variable read by internal/config.Load() is listed here with its
# built-in default. Copy to `.env` and override what you need; nothing is
# required for local development — the defaults match docker-compose.yml.
#
# ENV=staging|prod additionally HARD-FAILS at startup unless you set
# JWT_SECRET (>=32 bytes, not the dev default), CLIENT_IP_ASSERTION_SECRET
# (>=32 bytes) and a non-sandbox OTP_CHANNEL. See Config.validate().

# ---------------------------------------------------------------- runtime
ENV=dev
PORT=8080

# ------------------------------------------------------------- datastores
DATABASE_URL=postgres://avtotest:avtotest@localhost:5432/avtotest?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Public base for image storage keys (MinIO in dev).
MEDIA_BASE_URL=http://localhost:9000/media

# Origin users actually browse — the FRONTEND, not this API. Used to build
# shareable referral invite links (GET /me/referral -> invite_url).
# ./run.sh serves the frontend on :3000.
PUBLIC_BASE_URL=http://localhost:3000

# ------------------------------------------------------------------- auth
# Development default; MUST be replaced for staging/prod.
JWT_SECRET=dev-secret-change-me

# sandbox = OTP is only written to the log instead of being delivered (dev
# only, rejected when ENV=staging|prod). telegram = send via Telegram Gateway.
OTP_CHANNEL=sandbox
# Echo the OTP back in the POST /auth/otp/request response so local dev does
# not have to read the log. Requires OTP_CHANNEL=sandbox, is off unless set
# explicitly, and is refused outright when ENV=staging|prod — it is remote
# account takeover for any phone number if it ever reaches a real host.
OTP_DEBUG_ECHO=false
TELEGRAM_GATEWAY_TOKEN=
TELEGRAM_GATEWAY_URL=https://gatewayapi.telegram.org

# Signs the trusted client-IP assertion between proxy and API.
# Required (>=32 bytes) when ENV=staging|prod.
CLIENT_IP_ASSERTION_SECRET=

# ------------------------------------------------------------ telegram bot
# M4-06 foundation (auth-link + /start,/link,/status). A DIFFERENT Telegram
# product from TELEGRAM_GATEWAY_* above — the Gateway API only delivers OTP
# codes, it cannot receive updates or send arbitrary messages. Get a token
# from @BotFather. See
# docs/superpowers/specs/2026-07-25-m4-06-telegram-bot-design.md.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_API_BASE_URL=https://api.telegram.org
# No leading '@'. Only used to build the deep link returned by
# POST /me/telegram/link-token.
TELEGRAM_BOT_USERNAME=
# off = bot disabled (default). webhook = staging/prod, behind a public
# HTTPS URL you register once with Client.SetWebhook (see design §7).
# longpoll = local dev, no public URL needed; rejected when ENV=prod.
TELEGRAM_BOT_MODE=off
# Required when TELEGRAM_BOT_MODE=webhook. Compared against the
# X-Telegram-Bot-Api-Secret-Token header Telegram echoes back on every
# webhook call — this, not the request body, is what proves a call is
# really from Telegram.
TELEGRAM_WEBHOOK_SECRET=
# M4-07 on-demand /quiz needs MEDIA_BASE_URL reachable by Telegram's servers
# for sendPhoto (public HTTPS in staging/prod). Localhost images fall back to text.
# Optional cron: `make tg-digest-send` (~09:00 Asia/Tashkent) for linked-user DMs.

# ------------------------------------------------------- payments: Payme
# Cashbox id used to build the checkout URL.
PAYME_MERCHANT_ID=
# test -> PAYME_TEST_KEY is used; prod -> PAYME_KEY is used.
PAYME_ENV=test
PAYME_KEY=
PAYME_TEST_KEY=
# Left empty, the Payme webhook rejects every call with -32504, which is the
# correct behaviour for an unconfigured merchant.

# ------------------------------------------------------- payments: Click
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
# Left empty, Click signature verification rejects every call.

# -------------------------------------------------------------- ops admin
# Thin ops token for payment provider kill-switches (until M3 Super Admin).
# Empty = /ops/payment-providers routes are not mounted.
# Local UI: /uz-Latn/ops/providers
OPS_ADMIN_TOKEN=
# Shared secret for humo-watcher → POST /api/v1/internal/manual-pay/*
MANUAL_PAY_INGEST_TOKEN=

# ------------------------------------------------------ M3 super admin seed
# Local-only helper: `make seed-admin` (never commit a real password).
# Placeholders below are names only — set real values in your private .env.
ADMIN_SEED_EMAIL=admin@localhost
ADMIN_SEED_PASSWORD=change-me-admin-password
ADMIN_SEED_NAME=Superadmin
# When true/1: superadmin Me.totp_setup_required until TOTP enrolled (local default off).
ADMIN_TOTP_ENFORCE=false

# ------------------------------------------------------------- web push
# M4-08 / U-11. Generate with: npx web-push generate-vapid-keys
# Both keys empty = push disabled (subscribe returns web_push_unconfigured).
# Both must be set together. See
# docs/superpowers/specs/2026-07-26-m4-08-web-push-design.md.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@avtotest.uz

# ------------------------------------------------------------------ tests
# internal/testdb treats this as a *base*: the database named here must exist
# (compose/postgres-init creates it) and is used only to CREATE and connect to
# one database per test package, e.g. avtotest_test_internal_billing. That
# isolation is what makes a parallel `go test ./...` safe. `make test-db-reset`
# drops the derived databases.
TEST_DATABASE_URL=postgres://avtotest:avtotest@localhost:5432/avtotest_test?sslmode=disable

# Same idea for Redis: internal/redisx replaces the database index with the
# calling package's assigned slot (see testDBByPackage), because NewTest
# FLUSHDBs whatever it connects to. Index 1+ only — index 0 is the dev database
# REDIS_URL points at.
TEST_REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------- observability (U-41)
# Public GET /metrics serves Prometheus text by default; JSON via Accept or
# ?format=json (FE ops health). Not a full Prometheus/Grafana stack.
# SENTRY_DSN — optional sentry-go init in cmd/api. Empty = disabled no-op.
# Set a real project DSN when you have one. No pager / on-call product here.
SENTRY_DSN=

