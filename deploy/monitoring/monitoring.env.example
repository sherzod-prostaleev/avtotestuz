# Copy to a root-owned file outside Git, then fill with reviewed immutable
# references. Empty values are intentional: deployment fails closed until the
# operator supplies images as registry/repository@sha256:<64 hex characters>.
#
# Reviewed linux/amd64 candidates (Trivy 0 HIGH/CRITICAL on 2026-08-10) — copy
# into the host env only after re-running deploy/monitoring/verify_images.sh:
#   PROMETHEUS_IMAGE=quay.io/prometheus/prometheus@sha256:63805ebb8d2b3920190daf1cb14a60871b16fd38bed42b857a3182bc621f4996
#   ALERTMANAGER_IMAGE=quay.io/prometheus/alertmanager@sha256:27c475db5fb156cab31d5c18a4251ac7ed567746a2483ff264516437a39b15ba
#   BLACKBOX_EXPORTER_IMAGE=quay.io/prometheus/blackbox-exporter@sha256:92e05d5fe0df01d3980518dc42f07b778a8997048b57392ebc7f7391ebd7bb06
#   NODE_EXPORTER_IMAGE=quay.io/prometheus/node-exporter@sha256:d00a542e409ee618a4edc67da14dd48c5da66726bbd5537ab2af9c1dfc442c8a
PROMETHEUS_IMAGE=
BLACKBOX_EXPORTER_IMAGE=
NODE_EXPORTER_IMAGE=
ALERTMANAGER_IMAGE=

# Root-owned mode-0640, exactly one non-empty HTTPS URL line. Set its numeric
# group here; Compose grants only that supplemental group to Alertmanager.
ALERT_WEBHOOK_URL_FILE=/etc/drivergo/alert-webhook.url
ALERT_WEBHOOK_GID=65534

# Prometheus is bound to loopback only. Override only if another loopback port
# is required; do not publish the unauthenticated UI on a public interface.
PROMETHEUS_HOST_PORT=9091
ALERTMANAGER_HOST_PORT=9094
