[Unit]
Description=Driver Go encrypted full-stack backup
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/drivergo
Environment="COMPOSE_FILE=/opt/drivergo/deploy/docker-compose.prod.yml"
Environment="COMPOSE_ENV_FILE=/opt/drivergo/deploy/app.env"
Environment="BACKUP_ROOT=/var/backups/drivergo/full"
Environment="BACKUP_QUARANTINE_ROOT=/var/backups/drivergo/quarantine"
Environment="BACKUP_LOCK_FILE=/run/drivergo-backup/backup.lock"
Environment="ALLOW_PLAINTEXT_BACKUP=0"
Environment="REQUIRE_OFFSITE_BACKUP=1"
Environment="BACKUP_RETENTION_DAYS=14"
Environment="OFFSITE_RETENTION_DAYS=35"
Environment="BACKUP_MIN_SNAPSHOTS=3"
Environment="PRUNE_OFFSITE=1"
EnvironmentFile=/etc/drivergo/backup.env
ExecStart=/opt/drivergo/scripts/backup/backup_all.sh --production
RuntimeDirectory=drivergo-backup
RuntimeDirectoryMode=0700
UMask=0077
TimeoutStartSec=4h
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/backups/drivergo
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
