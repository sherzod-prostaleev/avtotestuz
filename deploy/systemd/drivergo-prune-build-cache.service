[Unit]
Description=Reclaim Docker build cache older than a week
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/drivergo
# A week: long enough that an incremental build still hits cache, short enough
# that the cache cannot grow to the 30 GB it reached before this existed.
Environment="BUILD_CACHE_KEEP=168h"
ExecStart=/opt/drivergo/deploy/prune-build-cache.sh
TimeoutStartSec=30m
Nice=15
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
