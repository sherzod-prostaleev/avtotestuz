# Install as /etc/drivergo/backup.env with mode 0600.
# Public age recipient only; keep its private identity off the VPS too.
AGE_RECIPIENT=age1replace_with_real_recipient

# Configure this root-owned file separately (0600); never commit it. It may
# contain the object-store/SSH credentials used by the named rclone remote.
RCLONE_CONFIG=/etc/drivergo/rclone.conf

# Use a dedicated, non-root prefix. The backup service fails closed when this
# is empty, and retention will only purge allowlisted snapshot directories
# below this prefix.
RCLONE_REMOTE=drivergo-offsite:drivergo/full
