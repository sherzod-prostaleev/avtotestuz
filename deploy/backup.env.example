# Install as /etc/drivergo/backup.env with mode 0600.
# Public age recipient only; keep its private identity off the VPS too.
AGE_RECIPIENT=age1replace_with_real_recipient

# Example: an encrypted S3/B2/SSH remote configured in root's rclone.conf.
# The systemd unit fails closed when this is empty.
RCLONE_REMOTE=drivergo-offsite:drivergo/postgres
