# Host-only webhook-file contract. Keep this file template in Git; create the
# referenced file outside Git as root:root-owned (or root:<gid>), mode 0640.
# Its numeric group must match ALERT_WEBHOOK_GID so Alertmanager receives only
# that supplemental group. The referenced file must contain exactly one
# non-empty HTTPS URL; do not put that URL in this template or any Compose env.
ALERT_WEBHOOK_URL_FILE=/etc/drivergo/alert-webhook.url
ALERT_WEBHOOK_GID=65534
