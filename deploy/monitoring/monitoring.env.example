# Copy to a root-owned file outside Git, then fill with reviewed immutable
# references. Empty values are intentional: deployment fails closed until the
# operator supplies images as registry/repository@sha256:<64 hex characters>.
PROMETHEUS_IMAGE=
BLACKBOX_EXPORTER_IMAGE=
NODE_EXPORTER_IMAGE=
ALERTMANAGER_IMAGE=

# Root-owned mode-0640, exactly one non-empty HTTPS URL line. Set its numeric
# group here; Compose grants only that supplemental group to Alertmanager.
ALERT_WEBHOOK_URL_FILE=/etc/drivergo/alert-webhook.url
ALERT_WEBHOOK_GID=65534

# Prometheus is bound to loopback only. Override only if another loopback port
# is required; do not publish the unauthenticated UI on a public interface.
PROMETHEUS_HOST_PORT=9091
ALERTMANAGER_HOST_PORT=9094
